# EditorConfig — https://editorconfig.org
# Keeps indentation/encoding consistent across editors and contributions.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown — don't strip them.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,ico,icns,ttf,otf,woff,woff2,mp3,mp4,pdf,db,zip}]
insert_final_newline = false
