{
  "name": "supercrzy-bot",
  "version": "1.2.1",
  "private": true,
  "description": "SUPERCRZY BOT - AI Agent Platform: unified brain + Agent Loop + multi-tool + multi-platform gateway",
  "author": "SuperCrzy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperCrzy/Supercrzy-Bot.git"
  },
  "homepage": "https://github.com/SuperCrzy/Supercrzy-Bot#readme",
  "bugs": {
    "url": "https://github.com/SuperCrzy/Supercrzy-Bot/issues"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @supercrzy/server dev\" \"pnpm --filter @supercrzy/client dev\"",
    "dev:server": "pnpm --filter @supercrzy/server dev",
    "dev:client": "pnpm --filter @supercrzy/client dev",
    "build": "pnpm --filter @supercrzy/client build && pnpm --filter @supercrzy/server build",
    "cli": "pnpm --filter @supercrzy/server cli",
    "lint": "pnpm -r lint",
    "check:clean": "node scripts/check-clean-tree.mjs",
    "version:sync": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "export:clean": "node scripts/check-clean-tree.mjs --export ../supercrzy-clean",
    "verify": "node scripts/version.mjs --check && node scripts/check-clean-tree.mjs && pnpm lint && pnpm test && pnpm --filter @supercrzy/server validate:tools && pnpm build",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "vue-demi"
    ],
    "overrides": {
      "http-errors": "^2.0.1",
      "entities": "^7.0.1"
    }
  },
  "bin": {
    "supercrzy": "bin/supercrzy.mjs"
  },
  "files": [
    "bin/",
    "packages/",
    "scripts/",
    "start.sh",
    "start.bat",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
