{
  "name": "deepseek-agent",
  "version": "0.1.0",
  "description": "DeepSeek Agent - AI Agent Platform with Web UI",
  "author": "SuperCrzy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperCrzy/deepseek-agent"
  },
  "homepage": "https://github.com/SuperCrzy/deepseek-agent#readme",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @deepseek-agent/server dev\" \"pnpm --filter @deepseek-agent/client dev\"",
    "dev:server": "pnpm --filter @deepseek-agent/server dev",
    "dev:client": "pnpm --filter @deepseek-agent/client dev",
    "build": "pnpm --filter @deepseek-agent/client build && pnpm --filter @deepseek-agent/server build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "vue-demi"]
  }
}
