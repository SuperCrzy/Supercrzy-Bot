{
  "name": "supercrzy",
  "version": "0.3.0",
  "description": "SuperCrzy - AI Agent Platform",
  "author": "SuperCrzy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperCrzy/supercrzy-agent"
  },
  "homepage": "https://github.com/SuperCrzy/supercrzy-agent#readme",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @supercrzy/server dev\" \"pnpm --filter @supercrzy/client dev\"",
    "dev:server": "pnpm --filter @supercrzy/server dev",
    "dev:client": "pnpm --filter @supercrzy/client dev",
    "build": "pnpm --filter @supercrzy/client build && pnpm --filter @supercrzy/server build",
    "cli": "pnpm --filter @supercrzy/server cli",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "vue-demi"
    ],
    "overrides": {
      "http-errors": "^2.0.1",
      "entities": "^4.5.0"
    }
  }
}
