{
  "name": "@supercrzy/server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-specifiers.mjs dist",
    "start": "tsx src/app.ts",
    "cli": "tsx src/cli.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules",
    "validate:tools": "tsx scripts/validate-tools.ts",
    "verify": "npm run lint && npm run test && npm run validate:tools"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^4.0.0",
    "@larksuiteoapi/node-sdk": "1.75.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tencent-weixin/openclaw-weixin": "^2.4.10",
    "@types/koa-static": "^4.0.4",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "https-proxy-agent": "^7.0.6",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.0",
    "koa-router": "^12.0.0",
    "koa-static": "^5.0.0",
    "localtunnel": "^2.0.2",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "node-edge-tts": "^1.2.11",
    "pdf-parse": "^2.4.5",
    "playwright-core": "1.64.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "uuid": "^11.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.0",
    "@types/koa-router": "^7.4.0",
    "@types/koa__cors": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
