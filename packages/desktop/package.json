{
  "name": "@supercrzy/desktop",
  "version": "1.3.0",
  "private": true,
  "description": "SUPERCRZY BOT desktop shell (Electron)",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --dev",
    "sync:version": "node ../../scripts/version.mjs",
    "check:version": "node ../../scripts/version.mjs --check",
    "sync:backend": "node scripts/sync-backend.mjs",
    "check:backend": "node scripts/sync-backend.mjs --check",
    "pack": "node ../../scripts/version.mjs && node scripts/sync-backend.mjs && electron-builder --dir",
    "dist": "node ../../scripts/version.mjs && node scripts/sync-backend.mjs && electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
