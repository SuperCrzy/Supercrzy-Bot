# SUPERCRZY BOT environment example
PORT=3000

# Provider fallback
OPENAI_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Database (relative to packages/server working directory)
DB_PATH=./data/supercrzy.db

# --- 安全加固（开源可用）---
# CORS 白名单（逗号分隔；默认仅本地端口）
# CORS_ORIGINS=http://localhost:5173
# API 鉴权令牌：配置后非本地来源的 API 请求需带 Authorization: Bearer <token>
# API_TOKEN=
