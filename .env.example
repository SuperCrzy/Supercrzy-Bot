# SuperCrzy Agent environment example
PORT=3000

# Provider fallback. The runtime can also read the key from the settings table.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Database (relative to packages/server working directory)
DB_PATH=./data/supercrzy.db
